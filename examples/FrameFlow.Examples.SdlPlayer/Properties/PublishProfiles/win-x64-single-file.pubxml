<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file publish profile for Windows x64.

  Usage:
    dotnet publish examples\FrameFlow.Examples.SdlPlayer\FrameFlow.Examples.SdlPlayer.csproj \
      /p:PublishProfile=win-x64-single-file

  What this produces:
    A single FrameFlow.Examples.SdlPlayer.exe in bin\Publish\win-x64\ that includes:
      - All managed assemblies and the .NET runtime (SelfContained=true)
      - All native libraries (FFmpeg DLLs, SDL, OpenAL) bundled inside the executable
        via IncludeNativeLibrariesForSelfExtract=true

  Runtime behaviour:
    On first run the AppHost extracts native libraries to
    %TEMP%\.net\FrameFlow.Examples.SdlPlayer\{hash}\runtimes\win-x64\native\.
    The FrameFlowBootstrapper detects this extraction directory automatically via
    ProbeBundleExtractionDirectory() (see ADR-0002 / ADR-0014).
    Subsequent runs reuse the cached extraction directory.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundle native DLLs (FFmpeg, SDL, OpenAL) inside the single exe.
         They are extracted to a temp dir by the AppHost on first run.

         Kept true HERE on purpose: this profile exists to exercise and
         demonstrate FrameFlowBootstrapper.ProbeBundleExtractionDirectory(),
         which handles exactly that extraction layout. This example is not
         distributed.

         LGPL WARNING if you copy this profile for an app you ship: FFmpeg and
         OpenAL Soft are LGPL-2.1, and embedding them here means a recipient
         cannot substitute their own build of those libraries. The release
         pipeline sets this to FALSE for that reason
         (.github/workflows/publish.yml). See THIRD-PARTY-NOTICES.md. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- ReadyToRun is off to keep publish fast; enable if startup time matters. -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
