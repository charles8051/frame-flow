<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Not a test project: it holds no tests and must not be collected by the
         runner. It is the shared support library the audio and integration
         suites both build their OpenAL coverage on (#146). -->
    <IsTestProject>false</IsTestProject>
    <!-- FakeOpenAlDevice implements IOpenAlApi, whose queue and BufferData
         members take raw pointers because the production Silk.NET signatures do. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameFlow.Audio.OpenAL\FrameFlow.Audio.OpenAL.csproj" />
  </ItemGroup>
</Project>
