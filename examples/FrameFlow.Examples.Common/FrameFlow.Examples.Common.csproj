<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared support code for the FrameFlow examples. Currently just the
    file-backed logging provider and the fixed-path factory over it, previously
    copy-pasted into each example (10 identical copies) alongside 11 hand-rolled
    log-file flag parsers. Keep this project tiny and dependency-light — it is
    example scaffolding, not library surface.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
    <!-- For ExampleLogging.CreateFactory: LoggerFactory.Create is in the concrete package. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- For DelegatingVideoSink: the sink contract every example already terminates at. -->
    <ProjectReference Include="..\..\src\FrameFlow.Media\FrameFlow.Media.csproj" />
  </ItemGroup>
</Project>
