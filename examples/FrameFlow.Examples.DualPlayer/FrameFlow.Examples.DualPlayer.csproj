<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Two independent players in ONE process. The example references the
         Layer-2 player API (FrameFlow.Player.MediaPlayer) as its primary
         surface, plus FrameFlow.Avalonia / FrameFlow.Audio.OpenAL for the
         concrete sink implementations. FrameFlow.Playback is referenced
         directly for the WallClockSource type used by the clock-source
         decorator (the wall-clock pane suppresses the audio sink's
         IClockSource so video paces off the wallclock fallback, ADR-0003). -->
    <ProjectReference Include="..\..\src\FrameFlow.Media\FrameFlow.Media.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Native\FrameFlow.Native.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Playback\FrameFlow.Playback.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Player\FrameFlow.Player.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Avalonia\FrameFlow.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Audio.OpenAL\FrameFlow.Audio.OpenAL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.*" />
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
    <!--
      FrameFlow.Native.Runtime ships the FFmpeg natives as NuGet runtime
      assets under runtimes/<rid>/native/. REQUIRED for any self-contained
      publish: the dev-time Directory.Build.targets copy is
      CopyToPublishDirectory="Never", so without this package a published app
      reaches the target with no FFmpeg (ADR-0014 / ADR-0046). Mirrors the
      AvaloniaPlayer / Multicast.Dml examples.
    -->
    <PackageReference Include="FrameFlow.Native.Runtime" Version="0.1.1-alpha.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared examples support (FileLoggerProvider). -->
    <ProjectReference Include="..\FrameFlow.Examples.Common\FrameFlow.Examples.Common.csproj" />
    <Using Include="FrameFlow.Examples.Common" />
  </ItemGroup>
</Project>
