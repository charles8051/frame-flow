<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrameFlow.Examples.LiveCaptioning.App"
             RequestedThemeVariant="Dark">
  <!-- Dark whatever the OS theme, to match the window and the player chrome. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
