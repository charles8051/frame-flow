<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrameFlow.Examples.AvaloniaPlayer.App"
             RequestedThemeVariant="Dark">
  <!-- Dark, so the chrome's Fluent buttons match the dark overlay in any OS theme. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
