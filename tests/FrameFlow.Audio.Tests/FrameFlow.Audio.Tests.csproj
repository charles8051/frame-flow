<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The fidelity tests drive FakeOpenAlDevice's pointer-taking members directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Opted out of the wall-clock ratchet in tests/Directory.Build.targets (ADR-0072).
      Temporary. The delays are in OpenAlAudioSinkTests and OpenAlAudioSinkMultiInstanceTests,
      which drive a real OpenAL device. OpenAlAudioSinkFakeDeviceTests already covers the same
      sink headless with no clock at all; moving the rest onto the fake device is how this
      line comes out.
    -->
    <FrameFlowBanWallClockInTests>false</FrameFlowBanWallClockInTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameFlow.Audio.OpenAL\FrameFlow.Audio.OpenAL.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Audio\FrameFlow.Audio.csproj" />
    <ProjectReference Include="..\FrameFlow.Audio.TestKit\FrameFlow.Audio.TestKit.csproj" />
  </ItemGroup>
</Project>
