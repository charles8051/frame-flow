<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ff="clr-namespace:FrameFlow.Avalonia;assembly=FrameFlow.Avalonia"
        xmlns:local="clr-namespace:FrameFlow.Examples.Camera.Inference.Dml"
        x:Class="FrameFlow.Examples.Camera.Inference.Dml.MainWindow"
        Width="960" Height="760"
        Title="FrameFlow — Camera inference (DirectML)"
        Background="#1a1a1a">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">

    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <Button Content="↻ Refresh" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnRefreshClick"/>
      <ComboBox Name="DevicePicker" PlaceholderText="Select a camera…"
                HorizontalAlignment="Stretch" SelectionChanged="OnCameraSelected">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </DockPanel>

    <Border Grid.Row="1" Background="Black" CornerRadius="3">
      <Grid>
        <ff:FrameFlowVideoView Name="VideoView"/>
        <local:DetectionOverlay Name="Overlay"/>
      </Grid>
    </Border>

    <TextBlock Grid.Row="2" Name="StatusText" Margin="0,8,0,0"
               Foreground="#cccccc" Text="Loading the model…"/>

  </Grid>
</Window>
