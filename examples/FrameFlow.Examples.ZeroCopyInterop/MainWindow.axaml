<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ffw="clr-namespace:FrameFlow.Avalonia.Windows;assembly=FrameFlow.Avalonia.Windows"
        x:Class="FrameFlow.Examples.ZeroCopyInterop.MainWindow"
        Width="1280" Height="720" Background="Black"
        Title="FrameFlow Zero-Copy Interop">
  <Panel>
    <ffw:CompositionInteropVideoView x:Name="VideoView" />
    <TextBlock x:Name="StatusText"
               Foreground="#A0FFFFFF" Margin="14"
               VerticalAlignment="Top" HorizontalAlignment="Left" />
  </Panel>
</Window>
