<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameFlow.Inference.Abstractions\FrameFlow.Inference.Abstractions.csproj" />
    <!-- FrameFlow.Inference.Ort: the shared host->ORT staging base
         (OrtInferenceSessionBase). Referenced here so the pure staging
         transforms (ToLongShape / MapDType / ValidateNames / ConvertDims)
         can be unit-tested directly — they are exposed via
         InternalsVisibleTo("FrameFlow.Inference.Abstractions.Tests") in the
         Ort project's AssemblyInfo.cs. These tests exercise only the pure
         transforms; they do NOT construct a real InferenceSession (which
         needs GPU/DML natives + a model), so they stay GPU-free. The
         reference pulls in Microsoft.ML.OnnxRuntime.Managed (managed-only,
         no native onnxruntime.dll), which is what makes that safe. -->
    <ProjectReference Include="..\..\src\FrameFlow.Inference.Ort\FrameFlow.Inference.Ort.csproj" />
  </ItemGroup>
</Project>
