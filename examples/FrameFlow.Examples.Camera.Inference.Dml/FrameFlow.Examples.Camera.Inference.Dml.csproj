<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <!-- A live camera with YOLOv8, or BlazeFace, running on DirectML and drawn over the picture. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameFlow.Media\FrameFlow.Media.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Avalonia\FrameFlow.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Video\FrameFlow.Video.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Camera\FrameFlow.Camera.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Yolo\FrameFlow.Yolo.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Face\FrameFlow.Face.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Inference.Dml\FrameFlow.Inference.Dml.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Graph\FrameFlow.Graph.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
    <PackageReference Include="Avalonia" Version="$(FrameFlowAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(FrameFlowAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(FrameFlowAvaloniaVersion)" />
    <PackageReference Include="Periphery" Version="4.1.0-alpha.*" />
    <PackageReference Include="Periphery.Camera" Version="4.1.0-alpha.*" />
    <!-- The FFmpeg libraries the BGRA convert runs on. DirectML.dll comes with FrameFlow.Inference.Dml. -->
    <PackageReference Include="FrameFlow.Native.Runtime" Version="$(FrameFlowNativeRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="FrameFlow.Graph" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameFlow.Examples.Common\FrameFlow.Examples.Common.csproj" />
    <Using Include="FrameFlow.Examples.Common" />
  </ItemGroup>

  <ItemGroup>
    <!-- DirectML is Windows-only, so this example is too. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
