<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required for LibraryImport source generation and pointer manipulation in FFmpeg interop wrappers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="9.*"
    />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
    <!-- Required so FrameFlowDecodingServiceCollectionExtensions can resolve
         IOptions<FrameFlowOptions> for the ADR-0033 hwaccel decoder factory. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameFlow.Media\FrameFlow.Media.csproj" />
    <ProjectReference Include="..\FrameFlow.Native\FrameFlow.Native.csproj" />
  </ItemGroup>
</Project>
