#version 450

// NV12 (or P010) to RGBA8. The decoded image is read through one view per plane, which FFmpeg's
// pool allows because it creates images MUTABLE_FORMAT | EXTENDED_USAGE with STORAGE usage.
// Nearest-neighbour chroma: this is a spike.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, r8) uniform readonly image2D luma;
layout(set = 0, binding = 1, rg8) uniform readonly image2D chroma;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Push
{
    ivec2 size;
    int bt709;
    int fullRange;
} pc;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y)
        return;

    float y = imageLoad(luma, p).r;
    vec2 uv = imageLoad(chroma, p / 2).rg - vec2(0.5);
    if (pc.fullRange == 0)
    {
        y = (y - 16.0 / 255.0) * (255.0 / 219.0);
        uv *= 255.0 / 224.0;
    }

    vec3 rgb = pc.bt709 != 0
        ? vec3(y + 1.5748 * uv.y, y - 0.1873 * uv.x - 0.4681 * uv.y, y + 1.8556 * uv.x)
        : vec3(y + 1.402 * uv.y, y - 0.344136 * uv.x - 0.714136 * uv.y, y + 1.772 * uv.x);

    imageStore(dst, p, vec4(clamp(rgb, 0.0, 1.0), 1.0));
}
