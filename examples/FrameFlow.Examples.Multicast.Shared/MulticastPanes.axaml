<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ff="clr-namespace:FrameFlow.Avalonia;assembly=FrameFlow.Avalonia"
             xmlns:local="clr-namespace:FrameFlow.Examples.Multicast.Shared"
             x:Class="FrameFlow.Examples.Multicast.Shared.MulticastPanes">
  <UserControl.Styles>
    <Style Selector="Border.pane">
      <Setter Property="Background" Value="#252525"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="Foreground" Value="#dddddd"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,*,*">
    <Border Classes="pane" Grid.Column="0">
      <DockPanel>
        <TextBlock Classes="title" DockPanel.Dock="Top" Text="As decoded"/>
        <Panel Background="Black">
          <ff:FrameFlowVideoView Name="DirectView"/>
        </Panel>
      </DockPanel>
    </Border>

    <Border Classes="pane" Grid.Column="1">
      <DockPanel>
        <TextBlock Classes="title" DockPanel.Dock="Top" Name="DetectionTitle" Text="Object detection"/>
        <Panel Background="Black">
          <ff:FrameFlowVideoView Name="DetectionView"/>
          <local:DetectionOverlay Name="Overlay"/>
        </Panel>
      </DockPanel>
    </Border>

    <Border Classes="pane" Grid.Column="2">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top">
          <ComboBox Name="FilterPicker" DockPanel.Dock="Right" MinWidth="120" Margin="8,0,0,6"/>
          <TextBlock Classes="title" Text="Color filter"/>
        </DockPanel>
        <Panel Background="Black">
          <ff:FrameFlowVideoView Name="FilteredView"/>
        </Panel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
