<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:FrameFlow.Examples.Multicast.Shared;assembly=FrameFlow.Examples.Multicast.Shared"
        x:Class="FrameFlow.Examples.Camera.Multicast.MainWindow"
        Width="1500" Height="700"
        Background="#1a1a1a"
        Title="FrameFlow camera multicast">
  <DockPanel Margin="8">
    <DockPanel DockPanel.Dock="Top" Margin="4">
      <ComboBox Name="CameraPicker"
                DockPanel.Dock="Left"
                MinWidth="320"
                PlaceholderText="Select a camera"
                DisplayMemberBinding="{Binding Name}"/>
      <TextBlock Name="StatusText" Foreground="#cccccc" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </DockPanel>
    <shared:MulticastPanes Name="Panes"/>
  </DockPanel>
</Window>
