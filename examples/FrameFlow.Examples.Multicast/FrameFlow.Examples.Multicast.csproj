<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The file multicast example on CUDA. Everything but the execution provider is in
    FrameFlow.Examples.Multicast.Shared; FrameFlow.Examples.Multicast.Dml is the same example on
    DirectML. The two cannot share a process: each carries its own ONNX Runtime native library.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameFlow.Examples.Multicast.Shared\FrameFlow.Examples.Multicast.Shared.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Inference.Cuda\FrameFlow.Inference.Cuda.csproj" />
  </ItemGroup>
</Project>
