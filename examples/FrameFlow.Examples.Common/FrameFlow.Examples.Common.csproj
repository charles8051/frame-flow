<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared support code for the FrameFlow examples: the file log under <repo>/logs/, the
    one-path command line, and a delegate video sink. Keep it small: it is example
    scaffolding, not library surface.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.*" />
    <ProjectReference Include="..\..\src\FrameFlow.Media\FrameFlow.Media.csproj" />
  </ItemGroup>
</Project>
