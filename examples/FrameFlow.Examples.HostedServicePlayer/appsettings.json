{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "FrameFlow": "Debug"
    }
  },
  "FrameFlow": {
    "Native": {
      "UseBundledBinaries": true
    },
    "Playback": {
      "AutoPlay": false,
      "UseAudioAsMasterClock": true
    },
    "Video": {
      "EnableVideo": false
    },
    "Audio": {
      "EnableAudio": true,
      "PreferredChannels": 2
    },
    "Buffering": {
      "MaxQueuedAudioPackets": 64,
      "MaxQueuedVideoPackets": 0,
      "MaxPendingFrames": 0
    }
  }
}
