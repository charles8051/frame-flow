<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ff="clr-namespace:FrameFlow.Avalonia;assembly=FrameFlow.Avalonia"
        xmlns:local="clr-namespace:FrameFlow.Examples.LiveCaptioning"
        x:Class="FrameFlow.Examples.LiveCaptioning.MainWindow"
        Title="FrameFlow — Live Captioning + Detection"
        Width="1100" Height="720"
        Background="#1a1a1a">
  <Grid RowDefinitions="*,Auto">

    <!-- Video, boxes, captions and status share one cell, drawn in document order. -->
    <Grid Grid.Row="0">
      <ff:FrameFlowVideoView Name="VideoView" />

      <local:DetectionOverlay Name="DetectionOverlay" />

      <Border Name="CaptionBackdrop"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              MaxWidth="900"
              Margin="0,0,0,32"
              Padding="16,10"
              CornerRadius="6"
              Background="#B0000000"
              IsVisible="False">
        <TextBlock Name="CaptionText"
                   Foreground="White"
                   FontSize="26"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </Border>

      <Border Name="AppStatusPill"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="12"
              Padding="10,4"
              CornerRadius="4"
              Background="#A0000000">
        <TextBlock Name="AppStatusText"
                   Foreground="#888"
                   FontFamily="Consolas,Menlo,monospace"
                   FontSize="12" />
      </Border>
    </Grid>

    <!-- The Open button appears once the models have loaded. -->
    <Border Grid.Row="1" Background="#1a1a1d" Padding="4">
      <ff:FrameFlowPlayerChrome Name="PlayerChrome"
                                HasOpenButton="False" />
    </Border>

  </Grid>
</Window>
