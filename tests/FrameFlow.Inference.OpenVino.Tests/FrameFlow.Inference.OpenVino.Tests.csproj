<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      No runtime identifier, as a consumer without one builds: Intel's natives then sit under
      runtimes/win-x64/native, and ONNX Runtime has to find OpenVINO and its plugins beside its own
      onnxruntime.dll there.
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OpenVINO package and no other, so the only native runtime is Intel's. -->
    <ProjectReference Include="..\..\src\FrameFlow.Inference.OpenVino\FrameFlow.Inference.OpenVino.csproj" />
  </ItemGroup>

  <!-- A project reference does not import a package's build targets; this does, as the package would. -->
  <Import Project="..\..\src\FrameFlow.Inference.OpenVino\buildTransitive\FrameFlow.Inference.OpenVino.targets" />

  <ItemGroup>
    <!-- The one-node test models the DirectML tests encode. -->
    <Compile Include="..\FrameFlow.Inference.Dml.Tests\OnnxModel.cs" Link="Shared\OnnxModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package runs only on Windows x64. The pure tests still run on every OS. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
