<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ff="clr-namespace:FrameFlow.Avalonia;assembly=FrameFlow.Avalonia"
        x:Class="FrameFlow.Examples.AvaloniaPlayer.MainWindow"
        Title="FrameFlow Player"
        Width="1280" Height="800"
        MinWidth="640" MinHeight="480"
        Background="#1a1a1a">

  <!--
    Video surface, transport bar, seek bar, volume, status badge, stream
    summary, position label, file picker, drag-drop and keyboard shortcuts
    all come from FrameFlow.Avalonia's FrameFlowPlayerView. What is left in
    this window is the playlist sidebar and the handler that builds a player.
  -->
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#2d2d2d"/>
      <Setter Property="Foreground" Value="#e0e0e0"/>
      <Setter Property="BorderBrush" Value="#555"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#3d3d3d"/>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Foreground" Value="#555"/>
      <Setter Property="Background" Value="#222"/>
      <Setter Property="BorderBrush" Value="#333"/>
    </Style>
    <!-- Playlist list: dark rows, green highlight on the now-playing item. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="2,1"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#1a6b3a"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#262626"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="300,4,*">

    <!-- Playlist sidebar: open a folder, list its files, follow playback. -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Background="#161616">
      <StackPanel Grid.Row="0" Margin="10" Spacing="8">
        <TextBlock Text="PLAYLIST" Foreground="#888" FontSize="11" FontWeight="SemiBold"/>
        <Button x:Name="OpenFolderButton"
                Content="Open Folder…"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"/>
        <Button x:Name="OpenFileButton"
                Content="Open File…"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"/>
        <TextBlock x:Name="StatusText"
                   Text="Open a folder to play through all of its media files."
                   Foreground="#777" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>

      <ListBox x:Name="PlaylistBox" Grid.Row="1"
               Margin="6,0,6,8"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"
                       Foreground="#ddd" FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Name}"
                       Padding="4,3"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!--
        The shortcuts are bound in FrameFlowPlayerView.OnKeyDown; this strip
        publishes them, because nothing on screen shows what they are.
      -->
      <Border Grid.Row="2"
              Background="#0d0d0d"
              BorderBrush="#222"
              BorderThickness="0,1,0,0"
              Padding="10,6">
        <TextBlock Foreground="#777"
                   FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                   FontSize="11"
                   TextWrapping="Wrap"
                   LineHeight="18">
          <Run Text="Space" Foreground="#bbb"/><Run Text=" play/pause"/>
          <LineBreak/>
          <Run Text="M" Foreground="#bbb"/><Run Text=" mute"/>
          <LineBreak/>
          <Run Text="←/→" Foreground="#bbb"/><Run Text=" seek ±5s"/>
          <LineBreak/>
          <Run Text="Double-click" Foreground="#bbb"/><Run Text=" a file to jump to it"/>
          <LineBreak/>
          <Run Text="Drop" Foreground="#bbb"/><Run Text=" a file on the player to open"/>
        </TextBlock>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="1"
                  ResizeDirection="Columns"
                  VerticalAlignment="Stretch"
                  Background="#333"
                  Width="4" />

    <ff:FrameFlowPlayerView x:Name="PlayerView" Grid.Column="2" />

  </Grid>

</Window>
