<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ff="clr-namespace:FrameFlow.Avalonia;assembly=FrameFlow.Avalonia"
        x:Class="FrameFlow.Examples.DualPlayer.MainWindow"
        Title="FrameFlow Dual Player"
        Width="1400" Height="820"
        MinWidth="720" MinHeight="480"
        Background="#1a1a1a">

  <Window.Styles>
    <Style Selector="TextBlock.paneTitle">
      <Setter Property="Foreground" Value="#e0e0e0"/>
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Styles>

  <!-- Two chromes would answer the same keys, so neither takes keyboard shortcuts. -->
  <Grid ColumnDefinitions="*,2,*">

    <DockPanel Grid.Column="0">
      <TextBlock x:Name="LeftTitle" DockPanel.Dock="Top" Classes="paneTitle"/>
      <ff:FrameFlowPlayerChrome x:Name="LeftChrome" DockPanel.Dock="Bottom"
                                Background="#161616"
                                HasOpenButton="False"
                                EnableKeyboardShortcuts="False"
                                LoopByDefault="True"/>
      <ff:FrameFlowVideoView x:Name="LeftVideo"/>
    </DockPanel>

    <Border Grid.Column="1" Background="#333"/>

    <DockPanel Grid.Column="2">
      <TextBlock x:Name="RightTitle" DockPanel.Dock="Top" Classes="paneTitle"/>
      <ff:FrameFlowPlayerChrome x:Name="RightChrome" DockPanel.Dock="Bottom"
                                Background="#161616"
                                HasOpenButton="False"
                                EnableKeyboardShortcuts="False"
                                LoopByDefault="True"/>
      <ff:FrameFlowVideoView x:Name="RightVideo"/>
    </DockPanel>

  </Grid>

</Window>
