<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- CpuFramePool moved to FrameFlow.Media during Crossbar
         ADR-0014 Phase 4 prep. The prior ProjectReference to
         FrameFlow.Playback was only here for that one type, and was
         dropped; nothing in this project needs Playback. -->
    <ProjectReference Include="..\FrameFlow.Media\FrameFlow.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="9.*"
    />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.*" />
    <PackageReference Include="Silk.NET.SDL" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="FrameFlow.Graph" />
    <!--
      Silk.NET.SDL.Sdl is the SDL2 wrapper this package wraps, and its
      unqualified name is unreachable from inside the package: FrameFlow.Sdl is
      an enclosing namespace, so a lookup of `Sdl` binds the namespace before
      any using directive is consulted. This is the cost of the assembly, the
      package and the namespace finally agreeing on one spelling; one alias
      here pays it once instead of in every file.
    -->
    <Using Include="Silk.NET.SDL.Sdl" Alias="SdlApi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FrameFlow.Graph/FrameFlow.Graph.csproj" />
  </ItemGroup>
</Project>
