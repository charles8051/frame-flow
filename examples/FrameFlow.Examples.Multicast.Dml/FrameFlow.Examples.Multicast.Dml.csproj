<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The file multicast example on DirectML. Everything but the execution provider is in
    FrameFlow.Examples.Multicast.Shared; FrameFlow.Examples.Multicast is the same example on CUDA.
    The two cannot share a process: each carries its own ONNX Runtime native library.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameFlow.Examples.Multicast.Shared\FrameFlow.Examples.Multicast.Shared.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Inference.Dml\FrameFlow.Inference.Dml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      FFmpeg's libraries for a published app. Inside this repository the build copies the
      binaries scripts/fetch-ffmpeg.cs puts under runtimes/; an app outside it needs this package.
    -->
    <PackageReference Include="FrameFlow.Native.Runtime" Version="$(FrameFlowNativeRuntimeVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- DirectML is Windows-only, so this example is too. -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
