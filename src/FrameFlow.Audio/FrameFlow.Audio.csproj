<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required for the swr_convert P/Invoke wrapper which constructs a
         byte** for the input plane pointer array on the stack. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameFlow.Media\FrameFlow.Media.csproj" />
    <ProjectReference Include="..\FrameFlow.Native\FrameFlow.Native.csproj" />
    <!-- Crossbar via the local-feed PackageReference shape (see
         ../../NuGet.config). Floating version range picks up freshest
         local build. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="FrameFlow.Graph" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FrameFlow.Graph/FrameFlow.Graph.csproj" />
  </ItemGroup>
</Project>
