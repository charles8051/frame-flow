<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\FrameFlow.Media\FrameFlow.Media.csproj" />
    <ProjectReference Include="..\FrameFlow.Player\FrameFlow.Player.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="9.*"
    />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.*" />
    <PackageReference Include="Silk.NET.OpenAL.Extensions.Soft" Version="2.*" />
    <!--
      Silk.NET.OpenAL is a managed wrapper only — it does not bundle the
      OpenAL Soft native runtime. On a fresh machine with no OpenAL
      installation, ALContext.GetApi() fails with "Could not load from any
      of the possible library names." Silk.NET.OpenAL.Soft.Native ships
      the OpenAL Soft binaries under runtimes/{rid}/native/ so the
      managed wrapper can resolve them without a system-wide install.
    -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    This package packs no native binaries. It ships the LGPL-2.1 text anyway
    because it pulls LGPL natives in transitively at publish time, so a
    recipient of a published application gets the terms with the bits.

    An earlier version of this comment claimed the set had been "determined
    empirically by unpacking every nupkg" and named four packages as carrying
    natives. Re-checked by reading the pack items: only FrameFlow.Native and
    FrameFlow.Native.Runtime do. The claim was wrong for this project.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE-LGPL-2.1.txt" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
