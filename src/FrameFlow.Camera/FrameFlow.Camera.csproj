<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    FrameFlow.Camera: integration layer between Periphery.Camera (capture)
    and FrameFlow.Graph (graph runtime). Per ADR-0049 §4 + ADR-0045 §3,
    Periphery's camera frames are substrate-independent (no Crossbar /
    FrameFlow.Graph inheritance); this package provides:

    - CameraFrameAdapter: wraps Periphery.Camera.ICameraFrame as a
      FrameFlow.Substrate.IFrame + IRefCounted item that flows through the
      substrate's nodes.

    - Source / sink adapters: same shape as the deleted
      Periphery.Camera.Pipelines/CameraSourceAdapters.cs +
      CameraFrameSinkAdapters.cs, re-targeted to FrameFlow.Graph.
  -->

  <ItemGroup>
    <ProjectReference Include="..\FrameFlow.Graph\FrameFlow.Graph.csproj" />
    <ProjectReference Include="..\FrameFlow.Media\FrameFlow.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
    <!-- Periphery.Camera via local-feed NuGet, matching how FrameFlow's
         other projects consume sibling workspace libraries. -->
    <PackageReference Include="Periphery.Camera" Version="4.1.0-alpha.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="FrameFlow.Graph" />
  </ItemGroup>
</Project>
