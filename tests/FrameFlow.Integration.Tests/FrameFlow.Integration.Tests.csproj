<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Opted out of the wall-clock ratchet in tests/Directory.Build.targets (ADR-0072).
      Permanent. This suite drives real FFmpeg decode through the playback stack and asserts
      real durations: that a 3 s clip takes about 3 s to play, that a loop restarts on time,
      that pause and resume land where they should. Elapsed time is what it measures, not an
      accident of how it was written. ADR-0072 records it as the one suite allowed to read the
      clock, so the exception is argued once rather than rediscovered per test.
    -->
    <FrameFlowBanWallClockInTests>false</FrameFlowBanWallClockInTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Crossbar via the local-feed PackageReference shape (see
         ../../NuGet.config). The version range floats so the
         tests build against whichever local Crossbar is freshest. -->
    <ProjectReference Include="..\..\src\FrameFlow.Media\FrameFlow.Media.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Native\FrameFlow.Native.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Decoding\FrameFlow.Decoding.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Playback\FrameFlow.Playback.csproj" />
    <!-- Integration coverage for the substrate playback controller
         (Crossbar ADR-0014 Phase 3). The parallel old/new suites that
         motivated this reference were collapsed when the old assemblies
         were deleted. -->
    <ProjectReference Include="..\..\src\FrameFlow.Sdl\FrameFlow.Sdl.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Avalonia\FrameFlow.Avalonia.csproj" />
    <!-- The real OpenAL sink, plus the fake device it can be pointed at, so the
         content invariants reach the sink itself rather than stopping at a
         capturing substitute for it (#146). -->
    <ProjectReference Include="..\..\src\FrameFlow.Audio.OpenAL\FrameFlow.Audio.OpenAL.csproj" />
    <ProjectReference Include="..\FrameFlow.Audio.TestKit\FrameFlow.Audio.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="FrameFlow.Graph" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FrameFlow.Graph/FrameFlow.Graph.csproj" />
  </ItemGroup>
</Project>
