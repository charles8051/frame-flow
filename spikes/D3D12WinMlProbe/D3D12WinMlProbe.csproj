<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The floor for Microsoft.Windows.AI.MachineLearning, as in WinMlProbe. -->
    <TargetFramework>net10.0-windows10.0.18362.0</TargetFramework>
    <RootNamespace>D3D12WinMlProbe</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Throwaway spike: not part of FrameFlow.slnx, not packed, not shipped. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Windows ML brings its own ONNX Runtime (1.27.1) as onnxruntime.dll, so this cannot share a
      process with D3D12DmlProbe's 1.24.4 DirectML package. Pinned to WinMlProbe's version.
    -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.3.42" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The decode, frame handles and NV12 shader are D3D12DmlProbe's, unchanged. -->
    <Compile Include="..\D3D12DmlProbe\Interop.cs" Link="Shared\Interop.cs" />
    <Compile Include="..\D3D12DmlProbe\GpuPreprocess.cs" Link="Shared\GpuPreprocess.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameFlow.Decoding\FrameFlow.Decoding.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Yolo\FrameFlow.Yolo.csproj" />
  </ItemGroup>

</Project>
