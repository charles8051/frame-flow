<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The multicast example on a live camera: the camera's frames go to the same three panes as the
    file examples', through a graph built here. YOLOv8 runs on CUDA, or on the CPU.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameFlow.Examples.Multicast.Shared\FrameFlow.Examples.Multicast.Shared.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Camera\FrameFlow.Camera.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Video\FrameFlow.Video.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Inference.Cuda\FrameFlow.Inference.Cuda.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(FrameFlowAvaloniaVersion)" />
    <!-- DeviceSessionHost, which keeps a session open on one camera. -->
    <PackageReference Include="Periphery" Version="4.1.0-alpha.*" />
    <PackageReference Include="Periphery.Camera" Version="4.1.0-alpha.*" />
  </ItemGroup>
</Project>
