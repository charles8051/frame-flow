<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameFlow.Native\FrameFlow.Native.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Decoding\FrameFlow.Decoding.csproj" />
    <!-- Migrated to PlaybackController.Create (Crossbar ADR-0014
         Phase 3). The FrameFlow.Playback reference is for
         IPlaybackController, which this example drives directly
         rather than going through IMediaPlayer. -->
    <ProjectReference Include="..\..\src\FrameFlow.Playback\FrameFlow.Playback.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Sdl\FrameFlow.Sdl.csproj" />
    <ProjectReference Include="..\..\src\FrameFlow.Audio.OpenAL\FrameFlow.Audio.OpenAL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.*" />
    <PackageReference Include="Silk.NET.SDL" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared examples support (FileLoggerProvider), consolidated from the
         former per-example copies into FrameFlow.Examples.Common. -->
    <ProjectReference Include="..\FrameFlow.Examples.Common\FrameFlow.Examples.Common.csproj" />
    <Using Include="FrameFlow.Examples.Common" />
  </ItemGroup>
</Project>
